# ============================================================
# Copie para .env e preencha. O .env nunca vai para o git.
# ============================================================

# --- Banco ---------------------------------------------------
# Role da aplicação: sujeita a Row-Level Security.
DATABASE_URL="postgresql://agente:agente_dev@localhost:5433/agente?schema=public"
# Role de super-admin: ignora RLS. Só as rotas de administração usam.
DATABASE_ADMIN_URL="postgresql://agente_admin:agente_admin_dev@localhost:5433/agente?schema=public"

# --- Modelo de IA --------------------------------------------
# Provider padrão do agente: anthropic | gemini
LLM_PROVIDER="anthropic"
# Provider de reserva, usado quando o padrão falha. Vazio desliga a queda.
LLM_PROVIDER_FALLBACK="gemini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Teto de iterações do loop de ferramentas por turno.
AGENTE_MAX_ITERACOES="6"
# Quantas mensagens o agente lembra por contato.
AGENTE_MEMORIA_MENSAGENS="50"

# --- Transcrição de áudio (Fase 2) ---------------------------
# whisper-openai | whisper-groq | gemini
STT_PROVIDER="whisper-openai"
OPENAI_API_KEY=""
GROQ_API_KEY=""

# --- Segredos ------------------------------------------------
# Chave-mestra AES-256-GCM que cifra credenciais de tenant em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=""

# --- App -----------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Tenant usado pelo /sandbox quando nenhum é escolhido.
SANDBOX_TENANT_PADRAO="clinica-estetica"

# Profundidade de raciocinio: low | medium | high | xhigh | max
# Atendimento e conversa curta — "low" costuma bastar e sai bem mais barato.
LLM_EFFORT="low"
# Teto de tokens por resposta do agente.
LLM_MAX_TOKENS="2000"
